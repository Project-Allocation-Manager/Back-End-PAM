PORT=3001
# When running with docker-compose.dev.yml the MySQL service is named `db`.
# Use `db` so the backend container can resolve the database service hostname.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Ph@131518
DB_NAME=PAM
JWT_SECRET=troque-esta-chave-em-desenvolvimento
# When the frontend is served from the nginx container mapped to host:8080,
# set FRONTEND_URL accordingly so CORS checks succeed.
FRONTEND_URL=http://localhost:8080
